{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Identity": "Host=localhost;Port=5432;Database=identity;Username=identity"
  },
  "Database": { "InitializeOnStart": true },
  "Argon2": { "MemoryKiB": 19456, "Iterations": 2, "Parallelism": 1 },
  "Lockout": { "Threshold": 5, "BaseSeconds": 30, "MaxSeconds": 3600 },
  "Server": { "Issuer": "https://localhost:5001/", "RequireHttps": true, "TrustForwardedHeaders": false },
  "Tokens": { "AccessTokenMinutes": 10, "RefreshTokenDays": 7 },
  "Cors": { "AllowedOrigins": [ "http://localhost:4200" ] },
  "OAuthClients": [
    { "ClientId": "admin-console", "DisplayName": "Admin console", "RedirectUris": [ "http://localhost:4200/auth/callback" ] }
  ],
  "Throttle": { "WindowSeconds": 60, "PerIpPermits": 30, "PerAccountPermits": 10 }
}
